+    };
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  #[\Override]
+  public static function outputSchema(): array {
+    // Only describes the base definition. Each derivative brings its own.
+    return [
+      'type' => 'null',
+    ];
+  }
+
+}
diff --git a/tests/modules/jsonrpc_test_attributes/src/Plugin/Derivative/DerivedMethodDeriver.php b/tests/modules/jsonrpc_test_attributes/src/Plugin/Derivative/DerivedMethodDeriver.php
new file mode 100644
index 0000000..4250d5e
--- /dev/null
+++ b/tests/modules/jsonrpc_test_attributes/src/Plugin/Derivative/DerivedMethodDeriver.php
@@ -0,0 +1,93 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\jsonrpc_test_attributes\Plugin\Derivative;
+
+use Drupal\Component\Plugin\Derivative\DeriverBase;
+use Drupal\Core\Plugin\Discovery\ContainerDeriverInterface;
+use Drupal\Core\State\StateInterface;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\jsonrpc\Attribute\JsonRpcParameterDefinition;
+use Drupal\jsonrpc\JsonRpcMethodDefinition;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Derives one method per derivative ID listed in state.
+ *
+ * Each derivative has its own parameters and output schema, so tests can tell
+ * them apart from each other and from the class-level schema.
+ */
+final class DerivedMethodDeriver extends DeriverBase implements ContainerDeriverInterface {
+
+  /**
+   * The state key listing the derivative IDs.
+   */
+  public const string STATE_KEY = 'jsonrpc_test_attributes.derivatives';
+
+  public function __construct(
+    private readonly StateInterface $state,
+  ) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  #[\Override]
+  public static function create(ContainerInterface $container, $base_plugin_id): static {
+    return new static($container->get('state'));
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  #[\Override]
+  public function getDerivativeDefinitions($base_plugin_definition): array {
+    assert($base_plugin_definition instanceof JsonRpcMethodDefinition);
+    $this->derivatives = [];
+    foreach ($this->state->get(self::STATE_KEY, ['echo', 'double']) as $derivative_id) {
+      $this->derivatives[$derivative_id] = new JsonRpcMethodDefinition([
+        'id' => $base_plugin_definition->id() . ':' . $derivative_id,
+        'class' => $base_plugin_definition->getClass(),
+        'provider' => $base_plugin_definition->getProvider(),
+        'usage' => new TranslatableMarkup('Derived method @id.', ['@id' => $derivative_id]),
+        'access' => $base_plugin_definition->access,
+      ] + self::specification($derivative_id));
+    }
+    return $this->derivatives;
+  }
+
+  /**
+   * Returns the parameters and output schema of a derivative.
+   *
+   * @param string $derivative_id
+   *   The derivative ID.
+   *
+   * @return array{params: array<string, \Drupal\jsonrpc\Attribute\JsonRpcParameterDefinition>|null, output: array<string, mixed>}
+   *   The definition values that differ between derivatives.
+   */
+  public static function specification(string $derivative_id): array {
+    return match ($derivative_id) {
+      'echo' => [
+        'params' => [
+          'text' => new JsonRpcParameterDefinition('text', ['type' => 'string'], required: TRUE),
+        ],
+        'output' => [
+          'type' => 'object',
+          'properties' => ['echo' => ['type' => 'string']],
+          'required' => ['echo'],
+        ],
+      ],
+      'double' => [
+        'params' => [
+          'number' => new JsonRpcParameterDefinition('number', ['type' => 'integer'], required: TRUE),
+        ],
+        'output' => ['type' => 'integer'],
+      ],
+      default => [
+        'params' => NULL,
+        'output' => ['type' => 'string'],
+      ],
+    };
+  }
+
+}
