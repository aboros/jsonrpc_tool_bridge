+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'serialization',
+    'jsonrpc',
+    'jsonrpc_discovery',
+    'jsonrpc_test_attributes',
+    'jsonrpc_test_annotations',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installEntitySchema('user');
+    // The test methods require 'access content'; uid 1 has every permission.
+    $this->container()->get('current_user')->setAccount(new UserSession(['uid' => 1]));
+  }
+
+  /**
+   * Every derivative is a supported method with its own definition.
+   */
+  #[DataProvider('baseMethods')]
+  public function testDerivativesAreSupportedMethods(string $base): void {
+    $methods = $this->handler()->supportedMethods();
+
+    $this::assertArrayNotHasKey($base, $methods);
+    $echo = $methods[$base . ':echo'] ?? NULL;
+    $double = $methods[$base . ':double'] ?? NULL;
+    $this::assertInstanceOf(JsonRpcMethodDefinition::class, $echo);
+    $this::assertInstanceOf(JsonRpcMethodDefinition::class, $double);
+
+    $this::assertSame($base . ':echo', $echo->id());
+    $this::assertSame(['text'], array_keys($echo->getParams() ?? []));
+    $this::assertSame(['number'], array_keys($double->getParams() ?? []));
+
+    $this::assertSame('object', $echo->output['type'] ?? NULL);
+    $this::assertSame(['type' => 'integer'], $double->output);
+  }
+
+  /**
+   * A call returns the result, validated against the derivative's schema.
+   */
+  #[DataProvider('baseMethods')]
+  public function testCallUsesDerivativeOutputSchema(string $base): void {
+    [$echo] = $this->handler()->batch([
+      new RpcRequest('2.0', $base . ':echo', FALSE, 1, new ParameterBag(['text' => 'hi'])),
+    ]);
+    $this::assertSame(['echo' => 'hi'], $echo->getResult());
+    $this::assertSame($this->handler()->getMethod($base . ':echo')?->output, $echo->getResultSchema());
+
+    [$double] = $this->handler()->batch([
+      new RpcRequest('2.0', $base . ':double', FALSE, 2, new ParameterBag(['number' => 21])),
+    ]);
+    $this::assertSame(42, $double->getResult());
+    $this::assertSame(['type' => 'integer'], $double->getResultSchema());
+  }
+
+  /**
+   * Over HTTP, the result passes validation against the derivative schema.
+   *
+   * The class-level schema says "null", so a result that is only checked
+   * against it would be rejected with an internal error.
+   */
+  #[DataProvider('baseMethods')]
+  public function testHttpCall(string $base): void {
+    $body = $this->post([
+      'jsonrpc' => '2.0',
+      'id' => 1,
+      'method' => $base . ':echo',
+      'params' => ['text' => 'hello'],
+    ]);
+    $this::assertSame(['echo' => 'hello'], $body['result'] ?? NULL);
+
+    $body = $this->post([
+      'jsonrpc' => '2.0',
+      'id' => 1,
+      'method' => $base . ':double',
+      'params' => ['number' => 'not a number'],
+    ]);
+    $this::assertSame(-32602, $body['error']['code'] ?? NULL);
+  }
+
+  /**
+   * Invalidating the cache tag picks up a changed set of derivatives.
+   */
+  public function testCacheTagRefreshesDerivatives(): void {
+    $state = $this->container()->get('state');
+    $this::assertTrue($this->handler()->supportsMethod('derived.test.attributes:echo'));
+
+    $state->set(DerivedMethodDeriver::STATE_KEY, ['echo', 'double', 'extra']);
+    // The definitions are cached, so the change is not visible yet.
+    $this::assertFalse($this->handler()->supportsMethod('derived.test.attributes:extra'));
+
+    Cache::invalidateTags(['jsonrpc_plugins']);
+    $this::assertTrue($this->handler()->supportsMethod('derived.test.attributes:extra'));
+    $this::assertSame(['type' => 'string'], $this->handler()->getMethod('derived.test.attributes:extra')?->output);
+
+    $state->set(DerivedMethodDeriver::STATE_KEY, ['double']);
+    Cache::invalidateTags(['jsonrpc_plugins']);
+    $this::assertFalse($this->handler()->supportsMethod('derived.test.attributes:echo'));
+    $this::assertFalse($this->handler()->supportsMethod('derived.test.attributes:extra'));
+    $this::assertTrue($this->handler()->supportsMethod('derived.test.attributes:double'));
+  }
+
+  /**
+   * Methods without a deriver still get the class-level output schema.
+   */
+  public function testNonDerivedMethodsKeepClassOutputSchema(): void {
+    foreach (['first.test.attributes', 'first.test.annotations'] as $id) {
+      $method = $this->handler()->getMethod($id);
+      $this::assertNotNull($method);
+      $this::assertSame(['type' => 'number'], $method->output);
+    }
+  }
+
+  /**
+   * The deriver class is not part of the discovery output.
+   */
+  public function testDiscoveryOmitsDeriver(): void {
+    $serializer = $this->container()->get('serializer');
+    $method = $this->handler()->getMethod('derived.test.attributes:echo');
+    $normalized = $serializer->normalize($method, 'json');
+    $this::assertIsArray($normalized);
+    $this::assertSame('derived.test.attributes:echo', $normalized['id']);
+    $this::assertArrayNotHasKey('deriver', $normalized['attributes']);
+    $this::assertArrayHasKey('output', $normalized['attributes']);
+
+    // A base definition that names its deriver does not leak it either.
+    $base = new JsonRpcMethodDefinition([
+      'id' => 'derived.test.attributes',
+      'deriver' => DerivedMethodDeriver::class,
+    ]);
+    $this::assertSame(DerivedMethodDeriver::class, $base->getDeriver());
+    $normalized = $serializer->normalize($base, 'json');
+    $this::assertIsArray($normalized);
+    $this::assertArrayNotHasKey('deriver', $normalized['attributes']);
+  }
+
+  /**
+   * Provides the base method IDs, one per discovery mechanism.
+   */
+  public static function baseMethods(): array {
+    return [
+      'attribute' => ['derived.test.attributes'],
+      'annotation' => ['derived.test.annotations'],
+    ];
+  }
+
+  /**
+   * Posts a JSON-RPC payload to the controller and decodes the body.
+   *
+   * @param array<mixed> $payload
+   *   A call.
+   *
+   * @return array<mixed>
+   *   The decoded response body.
+   */
+  private function post(array $payload): array {
+    $request = Request::create('/jsonrpc', 'POST', content: Json::encode($payload));
+    $stack = $this->container()->get('request_stack');
+    $stack->push($request);
+    try {
+      $response = HttpController::create($this->container())->resolve($request);
+    }
+    finally {
+      $stack->pop();
+    }
+    $this::assertInstanceOf(Response::class, $response);
+    $content = $response->getContent();
+    $this::assertIsString($content);
+    $body = Json::decode($content);
+    $this::assertIsArray($body);
+    return $body;
+  }
+
+  /**
+   * Gets the JSON-RPC handler.
+   */
+  private function handler(): HandlerInterface {
+    $handler = $this->container()->get('jsonrpc.handler');
+    $this::assertInstanceOf(HandlerInterface::class, $handler);
+    return $handler;
+  }
+
+  /**
+   * Gets the test container.
+   */
+  private function container(): ContainerBuilder {
+    $this::assertInstanceOf(ContainerBuilder::class, $this->container);
+    return $this->container;
+  }
+
+}
