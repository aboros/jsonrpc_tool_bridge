+/**
+ * Derived test method.
+ *
+ * @JsonRpcMethod(
+ *   id = "derived.test.annotations",
+ *   usage = @Translation("Derived test method."),
+ *   access = {"access content"},
+ *   deriver = "Drupal\jsonrpc_test_annotations\Plugin\Derivative\DerivedMethodDeriver",
